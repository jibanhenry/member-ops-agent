# 复制为 .env 后填写（.env 已被 git 忽略）。线上部署时把同名变量填到平台的环境变量里。

# 魔搭只读访问令牌：调用免费模型（API-Inference）+ 下载私有数据集
MODELSCOPE_TOKEN=
# 可选：DeepSeek 备用模型
DEEPSEEK_API_KEY=

# 可选覆盖
# LLM_BACKEND=auto            # auto / cloud / ollama / claude / offline
# LLM_PROVIDERS=modelscope,deepseek
# MODELSCOPE_MODEL=Qwen/Qwen3.8-Flash-Next
# DEEPSEEK_MODEL=deepseek-flash
# PRIVACY_MODE=standard        # strict：云端模型只拿汇总数据
# DEMO_MODE=0                  # 1：公开演示（访客修改定时恢复）
# CHAT_PER_MINUTE=6
# LLM_DAILY_LIMIT=80            # 一个问题约 2~4 魔粒，80 次约等于魔搭每天的 250 魔粒
# DATA_DATASET=Henrywu111/member-ops-data   # 线上容器下载数据用；本地上传数据时也会读
# STUDIO_REPO=Henrywu111/member-ops-agent   # 本地上传代码时用

# 只在本机上传代码和数据时用（魔搭写权限令牌，访问令牌页的 default），不要填到线上
MODELSCOPE_WRITE_TOKEN=
